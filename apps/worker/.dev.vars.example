# Local Worker secrets. Copy this file to `.dev.vars`; never commit `.dev.vars`.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
NEON_AUTH_ISSUER="https://your-branch-auth.neon.tech"
NEON_AUTH_JWKS_URL="https://your-branch-auth.neon.tech/.well-known/jwks.json"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
CLOUDFLARE_REALTIMEKIT_APP_ID="your-realtimekit-app-id"
CLOUDFLARE_REALTIMEKIT_API_TOKEN="your-realtimekit-api-token"
UPLOAD_SIGNING_SECRET="generate-at-least-32-random-characters"
